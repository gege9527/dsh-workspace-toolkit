{
  "name": "dsh-workspace-toolkit",
  "version": "0.4.0",
  "description": "DSH 工作区增强工具包：复制路径、批量归档会话、附件预览、长文本转附件、工作区路径迁移，以及归档会话的删除与只读查看",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "files": [
    "index.js",
    "client.js",
    "migration",
    "sessions",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gege9527/dsh-workspace-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/gege9527/dsh-workspace-toolkit/issues"
  },
  "homepage": "https://github.com/gege9527/dsh-workspace-toolkit#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "dsh-plugin",
    "workspace",
    "file-explorer",
    "session",
    "archive",
    "migration",
    "session-delete",
    "session-view"
  ]
}
