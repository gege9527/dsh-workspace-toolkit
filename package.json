{
  "name": "dsh-workspace-toolkit",
  "version": "0.0.3",
  "description": "DSH 工作区增强工具包：在资源管理器中打开、批量归档会话，以及后续文件/会话操作功能",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gege9527/dsh-workspace-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/gege9527/dsh-workspace-toolkit/issues"
  },
  "homepage": "https://github.com/gege9527/dsh-workspace-toolkit#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "dsh-plugin",
    "workspace",
    "file-explorer",
    "session",
    "archive"
  ]
}
